# ── Database ──────────────────────────────────────────────────
# Defaults to a local SQLite file under backend/ if unset.
# DATABASE_URL=postgresql://user:password@host:5432/vastrax

# ── JWT / Auth ───────────────────────────────────────────────
SECRET_KEY=changeme-min-32-chars-long-secret-key!!
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AWS (S3 for image uploads) ───────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_S3_BUCKET=vastrax-assets
# Only set when deploying the backend itself as a Lambda function.
AWS_LAMBDA_FUNCTION_NAME=

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8088


# ── CORS ─────────────────────────────────────────────────────
# Set to your deployed domain when going live, e.g.:
# ALLOWED_ORIGINS=https://vastrax.com,https://www.vastrax.com
# Leave as * for local / tunnel development
ALLOWED_ORIGINS=*

# Comma-separated origins the frontend is served from — used to build absolute
# redirect/callback URLs (e.g. Razorpay callbackUrl, password reset links).
FRONTEND_URL=http://localhost:3000

DEBUG=false

# ── Working Directories ──────────────────────────────────────
UPLOAD_DIR=user_uploads
RESULTS_DIR=results

# ── FASHN VTON 1.5 Model Paths (on the GPU machine) ─────────
# These point to the FASHN installation set up by gpu-setup/setup_fashn.sh
FASHN_VENV=/home/pkr/fashn-tryon/venv/bin/python
FASHN_SCRIPT=/home/pkr/fashn-tryon/fashn-vton-1.5/examples/basic_inference.py
FASHN_WEIGHTS=/home/pkr/fashn-tryon/fashn-vton-1.5/weights
FASHN_OUTPUT=/home/pkr/fashn-tryon/fashn-vton-1.5/results/output_00.png
FASHN_RESULTS=/home/pkr/fashn-tryon/fashn-vton-1.5/results
FASHN_TIMESTEPS=20
# Remote GPU inference server URL, e.g. http://192.168.1.3:8001 — when set, tried
# before falling back to the local FASHN_VENV/FASHN_SCRIPT subprocess.
FASHN_TRYON_URL=

# ── Razorpay Integration ──────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_MOCK
RAZORPAY_KEY_SECRET=MOCK_SECRET
RAZORPAY_WEBHOOK_SECRET=MOCK_WEBHOOK_SECRET

# ── Anthropic (AI Stylist) ────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Resend (Transactional Email) ─────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
